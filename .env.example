# Repository-root .env (git-ignored). Copy to .env and fill in. Never commit real values.
#
# Which process reads what:
#   researcher (port 8001)        GEMINI_API_KEY, TAVILY_API_KEY, RESEARCHER_TOKEN
#   verifier   (port 8002/Render) GEMINI_API_KEY, VERIFIER_TOKEN   (on Render: set in the service's Environment)
#   orchestrator (backend, 8000)  RESEARCHER_URL, RESEARCHER_TOKEN, VERIFIER_URL, VERIFIER_TOKEN
#                                 (database settings stay in backend/.env)
#   A1B CLI (python -m tracker)   GEMINI_API_KEY, TAVILY_API_KEY, TRACKER_USERNAME, TRACKER_PASSWORD

GEMINI_API_KEY=
TAVILY_API_KEY=

# Service tokens: one per worker, so a leaked verifier token doesn't unlock the researcher.
# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RESEARCHER_TOKEN=
VERIFIER_TOKEN=

# Where the orchestrator finds the workers (defaults in config.yaml: localhost:8001 / localhost:8002)
# RESEARCHER_URL=http://localhost:8001
# VERIFIER_URL=https://<your-service>.onrender.com

# Optional trace locations (default: traces/<service>.jsonl)
# ORCHESTRATOR_TRACE_PATH=
# RESEARCHER_TRACE_PATH=
# VERIFIER_TRACE_PATH=

# A1B single-agent CLI only. NYUgrader's credentials are published in the assignment handout.
TRACKER_USERNAME=
TRACKER_PASSWORD=
# TRACKER_API_URL=http://localhost:8000
